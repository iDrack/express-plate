{
    "name": "app_name",
    "version": "0.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "build": "npx tsc",
        "dev": "nodemon",
        "docker:compose": "docker compose up -d",
        "docker:ps": "docker ps",
        "docker:psa": "docker ps -a",
        "db:connect": "dotenv -e .env -- sh -c 'docker exec -it ${DOCKER_CONTAINER_NAME}-db psql -h localhost -p $DATABASE_PORT -d $DATABASE_NAME -U $DATABASE_USER'",
        "db:ready": "dotenv -e .env -- sh -c 'docker exec -it ${DOCKER_CONTAINER_NAME}-db pg_isready -h localhost -p $DATABASE_PORT -d $DATABASE_NAME -U $DATABASE_USER'",
        "redis:connect": "dotenv -e .env -- sh -c 'docker exec -it ${DOCKER_CONTAINER_NAME}-redis redis-cli -a ${REDIS_PASSWORD}'",
        "redis:ping": "dotenv -e .env -- sh -c 'docker exec -it ${DOCKER_CONTAINER_NAME}-redis redis-cli -a ${REDIS_PASSWORD} ping'",
        "redis:info": "dotenv -e .env -- sh -c 'docker exec -it ${DOCKER_CONTAINER_NAME}-redis redis-cli -a ${REDIS_PASSWORD} info'",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
